<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer layer for border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="2dp"
                android:color="#FF0000"/> <!-- Set the border color -->
            <corners android:radius="100dp"/> <!-- Make sure the radius matches CardView -->
        </shape>
    </item>

    <!-- Inner layer for the actual card background -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- Background color of the card -->
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
