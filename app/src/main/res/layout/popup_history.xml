<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/itemBatchReady"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Batch Ready"
        android:padding="8dp"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/itemNeedLoad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Need Load"
        android:padding="8dp"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/itemGoingForLoad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Going for Load"
        android:padding="8dp"
        android:textColor="@android:color/black" />
</LinearLayout>
