<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EBE8E8"
        android:id="@+id/colorBorderLayout"
        android:orientation="vertical">

        <!-- Top 10dp Border (Header) -->
        <LinearLayout
            android:id="@+id/top_border_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF9800"
            android:padding="5dp"
            android:orientation="horizontal">

            <!-- Left: Heading Text -->
            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Farmer"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <!-- Right: Kms Calculated Text -->
            <TextView
                android:id="@+id/tvKmsCalculated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@android:color/black"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Content Below Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:orientation="horizontal">

            <!-- Left: Icon -->
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:src="@drawable/animal"
                android:layout_marginEnd="8dp"/>

            <!-- Right: Name, Farm, City Text -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Name Text -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name: John Doe"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <!-- Farm Text -->
                <TextView
                    android:id="@+id/tvProperty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farm Name: Test Farm"
                    android:textColor="#37342E"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <!-- state Text -->
                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="State: AP"
                    android:textColor="#37342E"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"/>

                <!-- district Text -->
                <TextView
                    android:id="@+id/tvDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="District: Guntur"
                    android:textColor="#37342E"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <!-- status Text -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Batch Ready"
                    android:textColor="#37342E"
                    android:textSize="14sp"
                    android:textStyle="bold|italic"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
