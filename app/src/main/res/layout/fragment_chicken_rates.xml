<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id = "@+id/chicken_fragment_container"
    android:orientation="horizontal"
    android:background="@color/bgColor">

    <!-- Left Side: 30% width with Vertical Scroll and Round Buttons -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="#f0f0f0">

        <LinearLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp"
            android:id="@+id/stateButtonLayout"/>

    </ScrollView>

    <!-- Right Side: 70% width for State Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

        <!-- Date Label -->
        <TextView
            android:id="@+id/dateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10/10/2024"
            android:textColor="#FF0000"
            android:textSize="14sp"/>

        <!-- Top Labels: State Name and Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="5dp">

            <!-- Hen Image -->
            <ImageView
                android:id="@+id/henImageView"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/hen_rate_side"
                android:layout_gravity="center"
                android:layout_marginEnd="8dp"/>

            <!-- State Name Label -->
            <TextView
                android:id="@+id/stateNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telanagana"
                android:textColor="#000000"
                android:textSize="22sp"
                android:gravity="center"
                android:textStyle="bold"
                android:paddingRight="15dp"/>

        </LinearLayout>
    </LinearLayout>

        <include
            layout="@layout/chicken_rates_card"
            android:id="@+id/ratesCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp" />

    </LinearLayout>
</LinearLayout>
